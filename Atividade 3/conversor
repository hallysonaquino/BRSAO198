print("CONVERSOR DE TEMPERATURA MAGICO")
print("Unidades: C, F, K")

temp_str = input("Temperatura: ")
unidade_origem = input("De qual unidade (C, F ou K)? ").upper()
unidade_destino = input("Para qual unidade (C, F ou K)? ").upper()

temp = float(temp_str)
resultado = 0.0

if unidade_origem == "C":
    if unidade_destino == "F":
        resultado = (temp * 9/5) + 32
    elif unidade_destino == "K":
        resultado = temp + 273.15
    elif unidade_destino == "C":
        resultado = temp
    else:
        resultado = "UNIDADE DESTINO ERRADA"

elif unidade_origem == "F":
    if unidade_destino == "C":
        resultado = (temp - 32) * 5/9
    elif unidade_destino == "K":
        celsius = (temp - 32) * 5/9
        resultado = celsius + 273.15
    elif unidade_destino == "F":
        resultado = temp
    else:
        resultado = "UNIDADE DESTINO ERRADA"

elif unidade_origem == "K":
    if unidade_destino == "C":
        resultado = temp - 273.15
    elif unidade_destino == "F":
        celsius = temp - 273.15
        resultado = (celsius * 9/5) + 32
    elif unidade_destino == "K":
        resultado = temp
    else:
        resultado = "UNIDADE DESTINO ERRADA"

else:
    resultado = "UNIDADE DE ORIGEM ERRADA"


print("Voce queria converter de", unidade_origem, "para", unidade_destino)
print("Resultado da Conversao:")

if isinstance(resultado, float):
    print(round(resultado, 2), unidade_destino)
else:
    print("ERRO:", resultado)