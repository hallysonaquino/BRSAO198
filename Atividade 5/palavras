def checa_palindromo(texto):
    
    texto_limpo = ""
    for char in texto:
        if char.isalpha() or char.isdigit():
            texto_limpo += char
            
    texto_formatado = texto_limpo.lower()
    
    inverso = texto_formatado[::-1]
    
    if texto_formatado == inverso:
        return True
    else:
        return False

